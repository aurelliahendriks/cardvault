{
  "name": "cardvault",
  "version": "1.0.0",
  "private": true,
  "description": "Price intelligence and sell-routing engine for FIFA World Cup 2026 trading cards",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "embed": "tsx src/cli/embed.ts",
    "ingest": "tsx src/cli/ingest.ts",
    "revalue": "tsx src/cli/revalue.ts",
    "recommend": "tsx src/cli/recommend.ts",
    "ask": "tsx src/cli/ask.ts",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx src/cli/smoke.ts",
    "verify": "bash tools/verify.sh",
    "preview": "bash tools/preview.sh",
    "verify:art": "bash tools/verify-art.sh",
    "verify:players": "bash tools/verify-players.sh",
    "portraits": "tsx src/cli/portraits.ts",
    "user": "tsx src/cli/user.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "bullmq": "^5.34.2",
    "csv-parse": "^5.6.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}