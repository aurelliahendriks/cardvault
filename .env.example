# ---------------------------------------------------------------------------
# CardVault configuration. Copy to .env and fill in what you have.
# Nothing here is required to boot: with no keys at all the app still runs on
# your seeded prices + CSV imports, and every AI feature degrades to
# deterministic fallbacks.
# ---------------------------------------------------------------------------

# --- core ---
POSTGRES_USER=cardvault
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cardvault
POSTGRES_PORT=5432
API_PORT=8080
LOG_LEVEL=info

# Protects write endpoints. Send as `x-api-key`. Leave blank to disable auth
# (only safe if the app is behind your own reverse proxy / VPN).
ADMIN_API_KEY=

# Base currency for all reporting.
BASE_CURRENCY=AUD

# --- AI (Anthropic) -------------------------------------------------------
# Used for: fuzzy listing->card matching, natural-language search, and the
# written reasoning on sell recommendations.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_MATCH_MODEL=claude-haiku-4-5
# Hard monthly ceiling on AI spend, in USD. 0 = unlimited.
AI_MONTHLY_BUDGET_USD=20
# Embeddings: 'none' (trigram matching only), 'voyage', or 'openai'
EMBEDDING_PROVIDER=none
VOYAGE_API_KEY=
OPENAI_API_KEY=

# --- eBay -----------------------------------------------------------------
# developer.ebay.com -> your app -> Keys. Client credentials grant is enough
# for the Browse API (public data, no user consent needed).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production
# Marketplace Insights API is a limited release: you must apply to eBay for it.
# Set to true only once you've been granted access.
EBAY_INSIGHTS_ENABLED=false

# --- Bright Data ----------------------------------------------------------
# Paid, per-request. The reliable path to eBay *sold* comps without Insights.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=web_unlocker1
BRIGHTDATA_ENABLED=false
# Hard monthly ceiling on scrape requests. 0 = unlimited.
BRIGHTDATA_MONTHLY_REQUEST_CAP=5000

# --- Self-hosted scraping -------------------------------------------------
# Free but gets blocked. Keep the rate low and honour robots.txt.
SCRAPE_ENABLED=false
SCRAPE_CONCURRENCY=1
SCRAPE_MIN_DELAY_MS=8000
SCRAPE_USER_AGENT=CardVault/1.0 (personal collection tracker)

# --- imagery ---
# Card photos are harvested from matched listings and cached on disk. Mount this
# somewhere persistent in production so the gallery survives a container restart.
IMAGE_CACHE_DIR=/var/lib/cardvault/images

# --- player portraits -----------------------------------------------------
# Sourced from Wikidata + Wikimedia Commons. Free, no key. Almost all Commons
# images are CC BY or CC BY-SA, which REQUIRE attribution - the app stores the
# author, licence and file-page link for every portrait and displays them. If you
# republish the card art anywhere public, that credit has to travel with it.
# See docs/PORTRAITS.md.

# --- FX -------------------------------------------------------------------
# Free, no key: exchangerate.host / frankfurter.app
# Wikimedia asks for a contact in the User-Agent of anything hitting its APIs, and
# refuses requests that look generic - an email or a URL you control is enough. Without
# it the portrait backfill gets 403s rather than photographs.
WIKIMEDIA_CONTACT=
WIKIMEDIA_USER_AGENT=
# Minimum gap between Wikimedia REQUESTS, not between players - one player costs up to
# five requests (search, entity, labels, imageinfo, image). The fetcher backs off on its
# own when refused and creeps back afterwards; raise this if you still see 429s.
WIKIMEDIA_MIN_INTERVAL_MS=1100
# Players per scheduled run. 40 every 20 minutes clears a full 783-player backlog in
# about five hours and then costs nothing, because there is nothing left pending.
PORTRAITS_BATCH=40

FX_PROVIDER=frankfurter

# --- schedules (cron, server local time) ----------------------------------
CRON_FX=15 6 * * *
CRON_INGEST_HOT=0 */4 * * *
CRON_INGEST_FULL=0 3 * * *
CRON_REVALUE=30 4 * * *
CRON_ALERTS=50 4 * * *
CRON_RECOMMEND=0 5 * * *
CRON_IMAGES=45 4 * * *
CRON_PORTRAITS=*/20 * * * *

# --- ingestion scope ------------------------------------------------------
# Comma-separated marketplace codes to poll. Trim this to control cost.
INGEST_MARKETPLACES=EBAY_AU,EBAY_US,EBAY_UK,EBAY_DE
# Only auto-poll cards estimated above this AUD value (plus anything you hold
# and anything flagged hot). Stops you burning quota on 30c commons.
INGEST_MIN_VALUE_AUD=8
# Set to true ONLY when something sits in front of this server (Cloudflare Tunnel, nginx,
# Caddy). It makes the app believe X-Forwarded-For, which is how the login throttle sees the
# real visitor instead of the proxy. Left true with nothing in front, anyone can forge that
# header and the throttle stops working.
TRUST_PROXY=false

# --- your photographs -----------------------------------------------------
# Where photos of your own cards are stored, as ORDINARY FILES you can open in Explorer.
# The path is on this PC (the host), not inside Docker. Relative paths are relative to this
# folder; an absolute path is fine too, and a second disk is better than the system one.
#
#   PHOTO_DIR_HOST=./photos
#   PHOTO_DIR_HOST=D:/cardvault-photos
#
# Deliberately NOT a Docker volume. A volume lives where you cannot browse it and
# `docker compose down -v` deletes it - and unlike prices or the checklist, a photo of a card
# you have already sold cannot be regenerated from anywhere. Back this folder up:
# `tools\backup.ps1` zips it alongside the database dump.
PHOTO_DIR_HOST=./photos
